# ============================================================
#  Credenciales MEXC — copia este archivo a .env y rellénalo
#  NUNCA subas el archivo .env real al repositorio.
# ============================================================

# Clave y secreto de tu API de MEXC (Spot).
# Crea la API key en: https://www.mexc.com/user/openapi
# Recomendado: habilita SOLO permisos de "Spot Trading".
# NO habilites permisos de retiro (withdraw).
MEXC_API_KEY=tu_api_key_aqui
MEXC_API_SECRET=tu_api_secret_aqui

# Modo de ejecución:
#   paper = simulación, NO envía órdenes reales (por defecto y seguro)
#   live  = OPERA CON DINERO REAL (actívalo solo cuando estés seguro)
TRADING_MODE=paper

# ---------------- Agente de IA (opcional) ----------------
# Necesario solo si usas la estrategia ai_agent (decisiones con Claude).
# Crea tu API key en: https://platform.claude.com/
# Ojo: cada vela cerrada consume una llamada a la API de Anthropic (coste).
ANTHROPIC_API_KEY=

# ---------------- Notificaciones de Telegram (opcional) ----------------
# Deja ambos vacíos para desactivar las notificaciones.
# 1) Crea un bot con @BotFather y copia el token.
# 2) Escríbele a tu bot y visita https://api.telegram.org/bot<TOKEN>/getUpdates
#    para obtener tu chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
