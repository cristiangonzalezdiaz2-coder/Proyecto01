# ============================================================
#  Credenciales MEXC — copia este archivo a .env y rellénalo
#  NUNCA subas el archivo .env real al repositorio.
# ============================================================

# Clave y secreto de tu API de MEXC (Spot).
# Crea la API key en: https://www.mexc.com/user/openapi
# Recomendado: habilita SOLO permisos de "Spot Trading".
# NO habilites permisos de retiro (withdraw).
MEXC_API_KEY=tu_api_key_aqui
MEXC_API_SECRET=tu_api_secret_aqui

# Modo de ejecución:
#   paper = simulación, NO envía órdenes reales (por defecto y seguro)
#   live  = OPERA CON DINERO REAL (actívalo solo cuando estés seguro)
TRADING_MODE=paper
